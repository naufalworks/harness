# Never commit .env. Generate a random local token; do not reuse your provider key.
HARNESS_ADDR=127.0.0.1:8080
HARNESS_AUTH_TOKEN=
HARNESS_API_KEY=
HARNESS_BASE_URL=https://api.longcat.chat/openai
HARNESS_MODEL=LongCat-2.0
HARNESS_MAX_PROVIDER_REQUESTS_PER_TURN=32
HARNESS_MAX_PROVIDER_REQUESTS_PER_DAY=500
# Token and cost ceilings are opt-in. When a cost ceiling is set, configure both prices.
# HARNESS_MAX_PROVIDER_TOKENS_PER_TURN=1000000
# HARNESS_MAX_PROVIDER_TOKENS_PER_DAY=10000000
# HARNESS_MAX_PROVIDER_COST_MICROUSD_PER_TURN=100000
# HARNESS_MAX_PROVIDER_COST_MICROUSD_PER_DAY=1000000
# HARNESS_PROVIDER_INPUT_MICROUSD_PER_MILLION_TOKENS=
# HARNESS_PROVIDER_OUTPUT_MICROUSD_PER_MILLION_TOKENS=
HARNESS_DB=data/harness_v2.db
# Optional: comma-separated extra browser origins allowed to call the API.
# Loopback origins on HARNESS_ADDR's port are always allowed.
HARNESS_ALLOWED_ORIGINS=
