{
  "comment": [
    "Labeled recall fixtures for P15-T01. These drive the real DbStore::recall path from a Rust",
    "test (storage::tests::recall_eval_fixtures_meet_labeled_budgets), which writes metrics.json.",
    "tests/recall_eval/run.py --check then validates those metrics against the thresholds below.",
    "Labels: 'relevant' should be recalled, 'irrelevant' should not, 'stale' must never be",
    "recalled because the row is archived. age_days backdates updated_at so recency is exercised."
  ],
  "model": "harness-local-hash-v1",
  "thresholds": {
    "min_macro_precision": 0.60,
    "min_relevant_coverage": 0.80,
    "max_stale_use_rate": 0.0,
    "max_context_bytes": 6000,
    "max_case_latency_ms": 250
  },
  "cases": [
    {
      "id": "exact-lexical-hit",
      "scope": "proj",
      "prompt": "which database does this project use",
      "memories": [
        {"id": "m-db-proj", "scope": "proj", "key": "database", "value": "SQLite with WAL", "category": "project", "label": "relevant"},
        {"id": "m-fruit", "scope": "global", "key": "fruit", "value": "Banana orchestra", "category": "fact", "label": "irrelevant"}
      ]
    },
    {
