 /// Deny-list from docs/design/tools.md#bash: these always ask, even in `auto_all`.
 /// Lives here (not in bash_tool) so the permission gate compiles before P1-T08 lands.
+///
+/// Matching is token-based rather than substring-based so that spacing tricks (`curl$'\t'url`,
+/// `cmd|sh`), flag reordering (`rm -fr`, `rm -Rf`), and prefixes (`sudo`, `env`) cannot slip a
+/// deny-listed action past the `auto_all` gate. This is a heuristic gate for a single-user
+/// tool, not a sandbox: it errs towards asking, never towards silently allowing.
+fn command_tokens(cmd: &str) -> Vec<String> {
+    // Keep shell separators as their own tokens so `a|sh`, `a;sh` and `a&&sh` are visible.
+    const SEPARATORS: &[char] = &['|', ';', '&', '(', ')', '`', '\n', '\r'];
+    let mut out = Vec::new();
+    let mut current = String::new();
+    for ch in cmd.chars() {
+        if ch.is_whitespace() {
+            if !current.is_empty() {
+                out.push(std::mem::take(&mut current));
+            }
+        } else if SEPARATORS.contains(&ch) {
+            if !current.is_empty() {
+                out.push(std::mem::take(&mut current));
+            }
+            out.push(ch.to_string());
+        } else {
+            current.push(ch.to_ascii_lowercase());
+        }
+    }
+    if !current.is_empty() {
+        out.push(current);
+    }
+    out
+}
+
+/// A program name as invoked: `curl`, `/usr/bin/curl`, `./curl` and `curl.exe` all count.
+fn program_stem(token: &str) -> &str {
+    let name = token.rsplit('/').next().unwrap_or(token);
+    name.strip_suffix(".exe").unwrap_or(name)
