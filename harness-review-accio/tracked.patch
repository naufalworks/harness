+/// `rm` with both a recursive and a force flag aimed at a root, home, cwd, parent or glob.
+fn is_recursive_force_rm(tokens: &[String]) -> bool {
+    let mut i = 0;
+    while i < tokens.len() {
+        if program_stem(&tokens[i]) == "rm" {
+            let (mut recursive, mut force, mut wide_target) = (false, false, false);
+            let mut j = i + 1;
+            while j < tokens.len() && !matches!(tokens[j].as_str(), "|" | ";" | "&" | "&&" | "||") {
+                let t = tokens[j].as_str();
+                if t == "--recursive" {
+                    recursive = true;
+                } else if t == "--force" {
+                    force = true;
+                } else if t.starts_with('-') && !t.starts_with("--") {
+                    recursive |= t.contains('r') || t.contains('R');
+                    force |= t.contains('f');
+                } else {
+                    let trimmed = t.trim_matches(|c| c == '"' || c == '\'');
+                    wide_target |= matches!(trimmed, "/" | "/*" | "~" | "~/" | "~/*" | "." | "./" | ".*" | ".." | "../" | "*" | "./*" | "$home" | "$home/")
+                        || trimmed.starts_with("/*")
+                        || trimmed.starts_with("../");
+                }
+                j += 1;
+            }
+            if recursive && force && wide_target {
+                return true;
+            }
+        }
+        i += 1;
+    }
+    false
+}
+
+/// Something that fetches from the network on the left of a pipe feeding an interpreter.
+fn pipes_download_into_shell(tokens: &[String]) -> bool {
+    let stems: Vec<&str> = tokens.iter().map(|t| program_stem(t)).collect();
+    let mut seen_network = false;
+    let mut after_pipe = false;
+    for stem in stems {
+        if stem == "|" {
+            after_pipe = seen_network;
+            continue;
+        }
+        if NETWORK_PROGRAMS.contains(&stem) {
+            seen_network = true;
+        }
+        if after_pipe && SHELL_PROGRAMS.contains(&stem) {
+            return true;
+        }
+    }
+    false
+}
