+/// Quotes and escapes cannot hide a literal program spelling. Separators remain visible
+/// for pipeline/argument checks. Quoted data may over-trigger intentionally; expansion,
+/// aliases, shell functions and interpreter code are not resolved by this heuristic.
+fn command_tokens(cmd: &str) -> Vec<String> {
+    let mut tokens = Vec::new();
+    let mut word = String::new();
+    let mut chars = cmd.chars();
+    while let Some(ch) = chars.next() {
+        match ch {
+            '\'' | '"' => {}
+            '\\' => {
+                if let Some(escaped) = chars.next() {
+                    if escaped != '\n' {
+                        word.push(escaped.to_ascii_lowercase());
+                    }
+                }
+            }
+            c if c.is_whitespace() || matches!(c, '|' | '&' | ';' | '(' | ')' | '<' | '>' | '`') => {
+                if !word.is_empty() {
+                    tokens.push(std::mem::take(&mut word));
+                }
+                if !c.is_whitespace() {
+                    tokens.push(c.to_string());
+                }
+            }
+            c => word.push(c.to_ascii_lowercase()),
+        }
+    }
+    if !word.is_empty() {
+        tokens.push(word);
+    }
+    tokens
+}
+
+fn command_separator(token: &str) -> bool {
+    matches!(token, "|" | "&" | ";" | "(" | ")" | "<" | ">" | "`")
+}
+
+fn program_name(token: &str) -> &str {
+    token.rsplit('/').next().unwrap_or(token)
+}
