+fn destructive_root_target(target: &str) -> bool {
+    target.starts_with('/')
+        || target.starts_with('~')
+        || target.contains('*')
+        || target.split('/').any(|part| part == "..")
+        || (!target.is_empty() && target.split('/').all(|part| part.is_empty() || part == "."))
+}
