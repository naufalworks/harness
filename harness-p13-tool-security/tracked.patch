+fn recursive_force_removal(tokens: &[String]) -> bool {
+    tokens.iter().enumerate().any(|(index, token)| {
+        if program_name(token) != "rm" {
+            return false;
+        }
+        let mut recursive = false;
+        let mut force = false;
+        let mut root_target = false;
+        let mut options = true;
+        for arg in tokens[index + 1..]
+            .iter()
+            .take_while(|arg| !command_separator(arg))
+        {
+            if options && arg == "--" {
+                options = false;
+            } else if options && arg.starts_with('-') {
+                recursive |= arg == "--recursive" || has_short_flag(arg, 'r');
+                force |= arg == "--force" || has_short_flag(arg, 'f');
+            } else {
+                root_target |= destructive_root_target(arg);
+            }
+        }
+        recursive && force && root_target
+    })
+}
+
+fn pipe_to_shell(tokens: &[String]) -> bool {
