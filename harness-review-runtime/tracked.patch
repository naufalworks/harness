+/// Final write-time ownership check. `resolve` is the single disk gate; this is
+/// the name a mutating caller calls *again* immediately before the write. A diff
+/// may be planned and then wait behind a human approval for minutes, so
+/// re-resolving closes that window: an ancestor (or the file itself) swapped for
+/// a symlink is refused instead of being written through, and the caller can
+/// compare the result against the planned path.
+pub fn resolve_for_write(root: &Path, input: &str) -> Result<PathBuf, PathError> {
+    resolve(root, input)
+}
